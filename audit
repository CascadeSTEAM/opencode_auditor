#!/usr/bin/env bash
# audit — Launch or create an audit vault for a target host
#   audit                  → local machine (audit-$(hostname))
#   audit user@host        → remote host via SSH
#   audit --list | -l      → list existing vaults with target info
#   audit --help | -h      → show help
#
# Requires: toolkit at $HOME/opencode-auditor/repo (run bootstrap.sh first)
# Installs: symlinked to ~/.local/bin/ by setup/install.sh

set -euo pipefail

VAULT_BASE="${HOME}/opencode-auditor"
TOOLKIT_DIR="$VAULT_BASE/repo"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BOLD='\033[1m'; NC='\033[0m'
info()  { echo -e "${GREEN}✓${NC} $1"; }
warn()  { echo -e "${YELLOW}⚠${NC} $1"; }
fail()  { echo -e "${RED}✗${NC} $1"; }

show_help() {
  cat <<EOF
${BOLD}audit${NC} — Launch or create an audit vault for a target host

${BOLD}Usage:${NC}
  audit                        Audit this machine
  audit user@host              Audit a remote machine via SSH
  audit --list                 List existing vaults
  audit --help                 Show this help

${BOLD}Examples:${NC}
  audit                         # audit this machine
  audit server.example.com      # audit a remote server
  audit admin@10.0.1.5          # audit a remote server with user

${BOLD}Path:${NC}
  Vaults:  $VAULT_BASE/audit-<name>/
  Toolkit: $TOOLKIT_DIR/
EOF
}

slugify() {
  echo "$1" | sed 's/[^a-zA-Z0-9._-]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//'
}

list_vaults() {
  local found=false
  for dir in "$VAULT_BASE"/audit-*/; do
    [[ -d "$dir" ]] || continue
    found=true
    local name
    name=$(basename "$dir")
    local target_file="$dir/.audit-target.json"
    if [[ -f "$target_file" ]]; then
      local target hostname
      target=$(jq -r '.target // empty' "$target_file" 2>/dev/null)
      hostname=$(jq -r '.hostname // empty' "$target_file" 2>/dev/null)
      if [[ -n "$hostname" && "$hostname" != "$target" ]]; then
        printf "  %-30s remote: %s (%s)\n" "$name" "$target" "$hostname"
      else
        printf "  %-30s remote: %s\n" "$name" "$target"
      fi
    else
      printf "  %-30s local\n" "$name"
    fi
  done
  if ! $found; then
    echo "  No vaults found in $VAULT_BASE/"
    echo "  Run: audit  to create your first vault"
  fi
}

# --- Parse args ---
case "${1:-}" in
  --help|-h)
    show_help
    exit 0
    ;;
  --list|-l)
    list_vaults
    exit 0
    ;;
  "")
    TARGET="localhost"
    ;;
  *)
    TARGET="$1"
    ;;
esac

# --- Prerequisites ---
if [[ ! -d "$TOOLKIT_DIR" ]]; then
  fail "Toolkit not found at $TOOLKIT_DIR"
  echo "  Run the bootstrap first:"
  echo "    curl -fsSL https://raw.githubusercontent.com/CascadeSTEAM/opencode_auditor/main/bootstrap.sh | bash"
  exit 1
fi

if ! command -v opencode &>/dev/null; then
  fail "opencode is not installed"
  echo "  Install: curl -fsSL https://opencode.ai/install | bash"
  exit 1
fi

# --- Determine vault name ---
if [[ "$TARGET" == "localhost" ]]; then
  VAULT_NAME="audit-$(hostname)"
  VAULT_DIR="$VAULT_BASE/$VAULT_NAME"
else
  SAFE_NAME=$(slugify "$TARGET")
  VAULT_NAME="audit-$SAFE_NAME"
  VAULT_DIR="$VAULT_BASE/$VAULT_NAME"
fi

# --- Check remote reachability ---
if [[ "$TARGET" != "localhost" ]]; then
  echo "=== Checking remote host ==="
  if ssh -q -o ConnectTimeout=5 -o BatchMode=yes "$TARGET" exit 2>/dev/null; then
    info "$TARGET is reachable"
    REMOTE_HOSTNAME=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$TARGET" hostname 2>/dev/null || echo "$TARGET")
  else
    fail "Cannot reach $TARGET via SSH"
    echo "  Ensure:"
    echo "    - Passwordless SSH is configured: ssh-copy-id $TARGET"
    echo "    - The host is online and reachable"
    echo "  Test manually: ssh $TARGET"
    exit 1
  fi
fi

# --- Vault exists? ---
if [[ -d "$VAULT_DIR" ]]; then
  echo ""
  echo "Found existing vault at ${BOLD}$VAULT_DIR${NC}"
  read -rp "Use this vault? [Y/n] " REPLY
  if [[ -n "$REPLY" && ! "$REPLY" =~ ^[Yy] ]]; then
    echo "Aborted."
    exit 0
  fi
else
  # --- Create vault ---
  echo ""
  echo "Creating new vault: ${BOLD}$VAULT_NAME${NC}"

  mkdir -p "$VAULT_DIR/audits/completed"
  mkdir -p "$VAULT_DIR/mitigations"
  mkdir -p "$VAULT_DIR/metrics"
  mkdir -p "$VAULT_DIR/.obsidian/plugins"

  ln -snf "../repo/AGENTS.md" "$VAULT_DIR/AGENTS.md"
  ln -snf "../repo/docs"      "$VAULT_DIR/docs"

  cp "$TOOLKIT_DIR/startup.sh" "$VAULT_DIR/startup.sh"
  chmod +x "$VAULT_DIR/startup.sh"

  touch "$VAULT_DIR/.startup-required"

  cat > "$VAULT_DIR/opencode.json" << 'VAULTJSON'
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle",
          "tools": true,
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask"
  },
  "instructions": [
    "AGENTS.md"
  ]
}
VAULTJSON

  if [[ "$TARGET" != "localhost" ]]; then
    cat > "$VAULT_DIR/.audit-target.json" << TARGETJSON
{
  "target": "$TARGET",
  "hostname": "$REMOTE_HOSTNAME",
  "type": "remote"
}
TARGETJSON
    info "Remote target: $TARGET ($REMOTE_HOSTNAME)"
  fi

  echo ""
  info "Vault created: $VAULT_NAME"
fi

# --- Launch ---
echo ""
echo "Launching OpenCode in ${BOLD}$VAULT_NAME${NC} ..."
cd "$VAULT_DIR" && exec opencode
